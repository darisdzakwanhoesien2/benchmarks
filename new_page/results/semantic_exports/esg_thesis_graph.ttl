esgr:Record_r081_000 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_ar_sr_gtra_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_climate_detection ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_outcome ;
    esg:hasSentiment esgr:Sentiment_negative ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "Global dynamics in 2024 remained complex and uncertain, driven by rising geopolitical tensions and disruptions in commodity supply chains. Conflicts in Eastern Europe and the Middle East triggered supply chain instability and price surges across key commodities, prompting central banks around the world to raise benchmark interest rates in an effort to control inflation. Amid these pressures, many developing nations faced a tightening of financial conditions, making cost-efficiency and strategic adaptation essential for business continuity." ;
    esg:reasoning "Text discusses climate-related disruptions in commodity supply chains and their negative economic impacts, indicating climate risk." ;
    esg:timestamp "2026-04-08T02:58:28.918823Z" ;
    esg:sourceTarget "AR SR GTRA 2024___pdf/batch_10" ;
    esg:runIndex "81" ;
    esg:sentimentScore "-1.0" .

esgr:Record_r081_001 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_ar_sr_gtra_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_economic_resilience ;
    esg:hasPillar esgr:ESGPillar_s ;
    esg:hasTone esgr:Tone_outcome ;
    esg:hasSentiment esgr:Sentiment_positive ;
    esg:hasClimateLabel esgr:ClimateLabel_metrics ;
    esg:recordText "Indonesia, however, demonstrated consistent economic resilience, posting 5.03% GDP growth in 2024. This marked the third consecutive year of growth above 5%, supported by robust domestic consumption and a low inflation rate of 1.57%. With a 2025 national growth target of 5.2%, the government is focused on maintaining economic stability while enhancing industrial productivity." ;
    esg:reasoning "Text highlights positive economic outcomes with GDP growth and low inflation, indicating economic stability and resilience." ;
    esg:timestamp "2026-04-08T02:58:28.918823Z" ;
    esg:sourceTarget "AR SR GTRA 2024___pdf/batch_10" ;
    esg:runIndex "81" ;
    esg:recordIndex "1" ;
    esg:sentimentScore "1.0" .

esgr:Record_r081_002 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_ar_sr_gtra_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_economic_growth ;
    esg:hasPillar esgr:ESGPillar_s ;
    esg:hasTone esgr:Tone_outcome ;
    esg:hasSentiment esgr:Sentiment_positive ;
    esg:hasClimateLabel esgr:ClimateLabel_metrics ;
    esg:recordText "Within this environment, the transport and warehousing sector stood out with 8.69% growth, driven by increased activity in manufacturing and trade. As a result, logistics and transportation services continued to gain relevance as essential pillars of the national economy." ;
    esg:reasoning "Text reports positive growth in the transport and warehousing sector, contributing to the national economy." ;
    esg:timestamp "2026-04-08T02:58:28.918823Z" ;
    esg:sourceTarget "AR SR GTRA 2024___pdf/batch_10" ;
    esg:runIndex "81" ;
    esg:recordIndex "2" ;
    esg:sentimentScore "1.0" .

