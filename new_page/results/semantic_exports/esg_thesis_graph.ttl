    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "VKTR terus menjadi bagian penting dari solusi nasional menuju masa depan transportasi rendah karbon. Perjalanan ini bukan sekadar menghadirkan produk, tetapi membentuk sistem, sebuah ekosistem yang menjawab kebutuhan zaman dengan teknologi, tanggung jawab lingkungan, dan tekad kolektif membangun Indonesia yang lebih hijau dan tangguh." ;
    esg:reasoning "Teks menekankan peran VKTR dalam solusi transportasi rendah karbon, yang merupakan isu iklim. Tone-nya adalah komitmen masa depan, dan sentimen netral karena tidak ada evaluasi eksplisit." ;
    esg:timestamp "2026-04-08T03:02:43.232206Z" ;
    esg:sourceTarget "vktr_ar_sr_2024_pdf/batch_21" ;
    esg:runIndex "85" ;
    esg:recordIndex "2" .

esgr:Record_r085_003 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
