    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_strategy ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:recordText "Against this backdrop, Grahatrans pursued a clear and deliberate strategy: Achieving Growth Through Improvement. The Company proactively responded to global and domestic uncertainties by diversifying its client base and focusing on sectors less reliant on import-export activities. This strategic shift not only strengthened Grahatrans's operational resilience, but also allowed it to align with broader national growth trends." ;
    esg:reasoning "Text describes a strategic commitment to adapt to uncertainties, focusing on resilience and alignment with national trends." ;
    esg:timestamp "2026-04-08T02:58:28.918823Z" ;
    esg:sourceTarget "AR SR GTRA 2024___pdf/batch_10" ;
    esg:runIndex "81" ;
    esg:recordIndex "3" .

