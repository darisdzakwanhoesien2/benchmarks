    esg:hasPillar esgr:ESGPillar_g ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_governance ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:recordText "PTBA secara aktif telah memberikan pengetahuan kepada karyawan terkait SPP/WBS yang disalurkan melalui medial email serta dipublikasikan melalui sosial media perusahaan. Sejalan dengan hal tersebut, untuk mendukung pemanfaatan SPP/WBS secara optimal, PTBA berkomitmen untuk melindungi pelapor pelanggaran yang beritikad baik." ;
    esg:reasoning "Commitment to protect whistleblowers as part of governance policy." ;
    esg:timestamp "2026-04-08T02:44:57.770079Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_4" ;
    esg:runIndex "12" ;
    esg:recordIndex "5" .

esgr:Record_r012_006 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
