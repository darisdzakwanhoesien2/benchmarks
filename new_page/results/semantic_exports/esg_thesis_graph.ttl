esgr:Record_r000_000 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_best_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_environmental_claims ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_detection ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d_s ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_environmental_claims ;
    esg:recordText "As a pioneer among industrial estate developers in Indonesia, BeFa is at the forefront of creating a green and eco-friendly industrial zone. This transformative initiative aims to minimize environmental impact while promoting a sustainable economic model. It includes prioritizing renewable energy sources, implementing waste management systems, and ensuring efficient resource utilization." ;
    esg:reasoning "The text describes BeFa's commitment to creating a green and eco-friendly industrial zone with specific actions like prioritizing renewable energy, implementing waste management systems, and ensuring efficient resource utilization. This is a future-oriented commitment rather than an achieved outcome." ;
    esg:timestamp "2026-04-08T02:40:23.506816Z" ;
    esg:sourceTarget "BEST-SR_2024_pdf/batch_8" .

esgr:Record_r000_001 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_best_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_environmental_claims ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_detection ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d_s ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_environmental_claims ;
    esg:recordText "The Company is dedicated to continuous innovation and excellence within the realm of ESG, striving to create spaces that harmoniously blend industry with ecological sustainability. In its pursuit of this vision, BeFa is evolving into a Smart Eco-Industrial Park. This initiative focuses on promoting sustainable development through the incorporation of advanced technologies, smart infrastructure, and environmentally friendly practices that benefit both the community and the ecosystem. By fostering collaboration among tenants and other stakeholders, BeFa aims to set a precedent for responsible industrial growth while addressing global environmental challenges." ;
    esg:reasoning "The text describes BeFa's commitment to ESG excellence and evolving into a Smart Eco-Industrial Park with specific initiatives like advanced technologies, smart infrastructure, and environmentally friendly practices. This is a future-oriented commitment rather than an achieved outcome." ;
    esg:timestamp "2026-04-08T02:40:23.506816Z" ;
    esg:sourceTarget "BEST-SR_2024_pdf/batch_8" ;
