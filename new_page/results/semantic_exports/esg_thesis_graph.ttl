    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_netzero_reduction ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:recordText "PTBA berkomitmen mendukung target Pemerintah mencapai Emisi Nol Bersih atau Net Zero Emission pada 2060. Dengan visi menjadi perusahaan energi kelas dunia, PTBA telah memiliki roadmap manajemen karbon hingga 2050, baik bersifat pengurangan emisi (reducing emission sources/ maupun peningkatan penyerapan emisi (increase carbon sinks)." ;
    esg:reasoning "Explicit commitment to support government's Net Zero Emission target by 2060 with carbon management roadmap until 2050." ;
    esg:timestamp "2026-04-08T02:44:57.770079Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_4" ;
    esg:runIndex "12" ;
    esg:recordIndex "3" .

esgr:Record_r012_004 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_climate_action ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_action ;
    esg:hasSentiment esgr:Sentiment_positive ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_action ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:recordText "Berdasarkan manajemen karbon hingga 2050, terdapat 3 (tiga) pendekatan yang dilakukan PTBA, yaitu dekarbonisasi operasi, reklamasi, dan studi CCU (carbon capture, and utilization). Dengan langkah ini, PTBA optimis dapat menjadi Perusahaan yang berkelanjutan dan terus berkontribusi dalam pencapaian Net Zero Emission." ;
    esg:reasoning "Specific approaches to carbon management including operational decarbonization, reclamation, and CCU studies." ;
    esg:timestamp "2026-04-08T02:44:57.770079Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_4" ;
    esg:runIndex "12" ;
    esg:recordIndex "4" ;
    esg:sentimentScore "1.0" .

esgr:Record_r012_005 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
