esgr:Record_r088_000 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_commitment ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:recordText "PTBA berkomitmen mendukung target Pemerintah mencapai nol emisi. PTBA juga berkomitmen untuk menjalankan bisnis berkelanjutan dengan menerapkan keselarasan antara aspek Environmental, Social, and Governance (ESG)." ;
    esg:reasoning "Statement about commitment to net zero emission target and sustainable business practices with ESG alignment" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" .

esgr:Record_r088_001 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_action ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_action ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_action ;
    esg:recordText "Perseroan senantiasa melakukan berbagai optimasi menuju pertambangan yang lebih ramah lingkungan. Langkah nyata yang diambil antara lain menerapkan eco, mechanized mining yaitu mengganti peralatan pertambangan yang menggunakan bahan bakar fosil menjadi elektrik, e-mining reporting system yaitu, system pelaporan produksi secara real time dan daring dan berbagai program manajemen karbon di area operasional penambangan." ;
    esg:reasoning "Description of concrete actions taken to make mining more environmentally friendly including eco-mechanized mining and carbon management programs" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "1" .

esgr:Record_r088_002 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_action ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_action ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_action ;
    esg:recordText "Perseroan juga menciptakan sinergi dan kerja sama dengan berbagai mitra strategis dalam mewujudkan energi bersih seperti pengembangan PLTS, PLTB, tanaman Kaliandra untuk mengurangi emisi karbon dan menjadi simpanan biomassa untuk diolah menjadi wood pellet sebagai bahan campuran co-firing di PLTU serta Carbon Capture, Utilization (CCU) atau penangkapan karbon dioksida dan dikonversi menjadi methanol." ;
    esg:reasoning "Description of specific actions to create clean energy through partnerships and various renewable energy projects" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "2" .

esgr:Record_r088_003 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_netzero_reduction ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_netzero_reduction ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_f ;
    esg:recordText "PTBA berkomitmen mendukung target Pemerintah mencapai Emisi Nol Bersih atau Net Zero Emission pada 2060. Dengan visi menjadi perusahaan energi kelas dunia, PTBA telah memiliki roadmap manajemen karbon hingga 2050, baik bersifat pengurangan emisi (reducing emission sources/ maupun peningkatan penyerapan emisi (increase carbon sinks)." ;
    esg:reasoning "Statement about commitment to Net Zero Emission by 2060 with specific carbon management roadmap until 2050" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "3" .

esgr:Record_r088_004 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_strategy ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_strategy ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:recordText "Berdasarkan manajemen karbon hingga 2050, terdapat 3 (tiga) pendekatan yang dilakukan PTBA, yaitu dekarbonisasi operasi, reklamasi, dan studi CCU (carbon capture, utilization, and utilization)." ;
    esg:reasoning "Description of specific approaches for carbon management including decarbonization, reclamation, and CCU studies" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "4" .

esgr:Record_r088_005 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_governance ;
    esg:hasPillar esgr:ESGPillar_g ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_governance ;
    esg:hasClimateLabel esgr:ClimateLabel_environmental_claims ;
    esg:recordText "PTBA memiliki sikap tegas terhadap korupsi sebagai bagian dari komitmen Perusahaan dalam menjalankan bisnis yang bersih, transparan, dan berintegritas. Perusahan menolak segala bentuk praktik korupsi, kolusi, dan nepotisme, baik dalam hubungan internal maupun eksternal perusahaan." ;
    esg:reasoning "Statement about firm stance against corruption as part of commitment to clean, transparent, and ethical business practices" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "5" .

esgr:Record_r088_006 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_governance ;
    esg:hasPillar esgr:ESGPillar_g ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_governance ;
    esg:hasClimateLabel esgr:ClimateLabel_environmental_claims ;
    esg:recordText "PTBA merumuskan benturan kepentingan sebagai pertentangan kepentingan ekonomis pribadi dengan kepentingan ekonomis Perusahaan yang berdampak pada Objektivitas serta pertimbangan komersial. Setiap individu jajaran PTBA dilarang berada dalam situasi yang menimbulkan benturan kepentingan." ;
    esg:reasoning "Definition of conflict of interest and policy prohibiting individuals from being in situations that create conflicts of interest" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "6" .

esgr:Record_r088_007 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_governance ;
    esg:hasPillar esgr:ESGPillar_g ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_governance ;
    esg:hasClimateLabel esgr:ClimateLabel_environmental_claims ;
    esg:recordText "Untuk menghindari terjadinya benturan kepentingan, Perusahaan menetapkan beberapa prinsip kebijakan sebagai berikut: 1. Anggota Dewan Komisaris dan Direksi harus mengungkapkan kepemilikan saham di Perseroan atau di perusahaan lain dalam daftar khusus sebagaimana jadi dipersyaratkan peraturan perundang-undangan yang berlaku. 2. Setiap individu jajaran Perseroan dilarang memanfaatkan jabatan untuk kepentingan pribadi atau untuk kepentingan orang lain atau pihak lain yang merugikan kepentingan Perseroan. 3. Setiap individu jajaran Perseroan dilarang menggunakan informasi penting dan rahasia bagi kepentingan pribadi atau untuk kepentingan orang lain, atau pihak lain yang merugikan kepentingan Perseroan. 4. Setiap individu jajaran Perseroan sebaiknya menghindari kepentingan ekonomi dalam perusahaan yang dapat menimbulkan benturan kepentingan ekonomi." ;
    esg:reasoning "Description of specific policy principles to avoid conflicts of interest including disclosure requirements and prohibitions" ;
    esg:timestamp "2026-04-08T03:03:36.232065Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_5" ;
    esg:runIndex "88" ;
    esg:recordIndex "7" .

esgr:Record_r088_008 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
