    esg:hasTone esgr:Tone_action ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_governance ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:recordText "Sebaliknya, Perusahaan akan memberikan sanksi bagi pelapor yang membuka kerahasiaan komunikasi dan informasi yang timbul dalam proses penanganan pelaporan dan pelapor yang menyampaikan laporan yang tidak benar kepada laporan yang bersifat fitnah kepada palsu." ;
    esg:reasoning "Action to impose sanctions on whistleblowers who violate confidentiality or submit false reports." ;
    esg:timestamp "2026-04-08T02:44:57.770079Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_4" ;
    esg:runIndex "12" ;
    esg:recordIndex "6" .

