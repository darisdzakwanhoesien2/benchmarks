    esg:hasSentiment esgr:Sentiment_positive ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_detection ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "Keberhasilan pembangunan fasilitas perakitan kendaraan listrik di Magelang menjadi tonggak penting yang mencerminkan langkah nyata industrialisasi hijau di tingkat nasional. Dengan mengedepankan standar lokal dan pemberdayaan rantai pasok dalam negeri, VKTR memperluas cakupan dampak transformasi, dari aspek teknologi hingga penciptaan nilai ekonomi dan sosial." ;
    esg:reasoning "Teks menyoroti keberhasilan pembangunan fasilitas kendaraan listrik sebagai tonggak industrialisasi hijau, yang merupakan klaim lingkungan positif. Tone-nya adalah outcome dengan sentimen positif karena mencerminkan hasil nyata." ;
    esg:timestamp "2026-04-08T03:02:43.232206Z" ;
    esg:sourceTarget "vktr_ar_sr_2024_pdf/batch_21" ;
    esg:runIndex "85" ;
    esg:recordIndex "1" ;
    esg:sentimentScore "1.0" .

esgr:Record_r085_002 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
