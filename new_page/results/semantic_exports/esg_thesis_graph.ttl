    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:recordText "PTBA berkomitmen mendukung target Pemerintah mencapai nol emisi. PTBA juga berkomitmen untuk menjalankan bisnis berkelanjutan dengan menerapkan keselarasan antara aspek Environmental, Social, and Governance (ESG)." ;
    esg:reasoning "Explicit commitment to support government's net-zero emission target and sustainable business with ESG alignment." ;
    esg:timestamp "2026-04-08T02:44:57.770079Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_4" ;
    esg:runIndex "12" .

esgr:Record_r012_001 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_zero_shot_english_md ;
    esg:hasAspect esgr:Aspect_environmental_claims ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_action ;
    esg:hasSentiment esgr:Sentiment_positive ;
    esg:hasClimateLabel esgr:ClimateLabel_environmental_claims ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:recordText "Untuk mendukung itu, Perseroan senantiasa melakukan berbagai optimasi menuju pertambangan yang lebih ramah lingkungan. Langkah nyata yang diambil antara lain menerapkan eco, mechanized mining yaitu mengganti peralatan pertambangan yang menggunakan bahan bakar fosil menjadi elektrik, e-mining reporting system yaitu, system pelaporan produksi secara real time dan daring dan berbagai program manajemen karbon di area operasional penambangan." ;
    esg:reasoning "Concrete actions taken to optimize environmentally friendly mining including eco-mechanized mining and carbon management programs." ;
    esg:timestamp "2026-04-08T02:44:57.770079Z" ;
    esg:sourceTarget "20250526113828-2025-05-26ptba_laporan_berkelanjutan113825_pdf/batch_4" ;
    esg:runIndex "12" ;
    esg:recordIndex "1" ;
    esg:sentimentScore "1.0" .

esgr:Record_r012_002 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_20250526113828_2025_05_26ptba_laporan_berkelanjutan113825 ;
