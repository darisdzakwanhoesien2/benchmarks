esgr:Record_r043_000 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_detection ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "Sepanjang tahun 2024, VKTR mengukuhkan peran strategisnya dalam membentuk lanskap baru transportasi berkelanjutan di Indonesia. Tidak hanya sebagai perintis, VKTR kini hadir sebagai arsitek utama yang merancang dan mewujudkan solusi mobilitas hijau yang adaptif dan menyeluruh. Melalui pengembangan kendaraan listrik komersial lintas sektor, mulai dari truk dan bus, hingga solusi logistik dan angkutan perkotaan, VKTR memperkenalkan model mobilitas yang tidak hanya efisien, tetapi juga berorientasi pada masa depan rendah emisi." ;
    esg:reasoning "Teks membahas komitmen VKTR dalam mengembangkan transportasi berkelanjutan dan kendaraan listrik, yang secara langsung terkait dengan isu iklim dan lingkungan. Pernyataan ini bersifat umum namun spesifik dalam konteks bisnis transportasi." ;
    esg:timestamp "2026-04-08T02:53:20.718700Z" ;
    esg:sourceTarget "vktr_ar_sr_2024_pdf/batch_20" ;
    esg:runIndex "43" .

esgr:Record_r043_001 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
