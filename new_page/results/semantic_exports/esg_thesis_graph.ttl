    esg:hasClimateLabel esgr:ClimateLabel_metrics ;
    esg:recordText "Langkah nyata yang diambil antara lain menerapkan eco, mechanized mining yaitu mengganti peralatan pertambangan yang menggunakan bahan bakar fosil menjadi elektrik, e-mining reporting system yaitu, system pelaporan produksi secara real time dan daring dan berbagai program manajemen karbon di area operasional penambangan." ;
    esg:reasoning "Tindakan spesifik mengganti peralatan fosil ke listrik dan implementasi sistem pelaporan real-time." ;
    esg:timestamp "2026-04-08T02:46:34.453805Z" ;
