    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "Pada tanggal 10 Oktober 2023, Perusahaan dan MB menandatangani perjanjian kerja sama antara BA, Entitas Anak, dan MB, dimana Perusahaan akan menyediakan jasa perawatan, perbaikan dan penyediaan suku cadang untuk BYD yang dibutuhkan oleh Kendaraan Bus Listrik BYD K9 LF milik MB. Perusahaan menyatakan bersedia untuk bekerja sama dengan MB dalam hal perawatan, perbaikan, dan penyediaan suku cadang untuk Kendaraan Bus Listrik BYD K9 LF." ;
    esg:reasoning "Teks menggambarkan kerja sama teknis untuk perawatan kendaraan listrik, yang secara tidak langsung mendukung penggunaan kendaraan rendah emisi. Namun, fokusnya lebih pada aspek operasional daripada komitmen iklim secara langsung." ;
    esg:timestamp "2026-04-08T02:53:20.718700Z" ;
    esg:sourceTarget "vktr_ar_sr_2024_pdf/batch_20" ;
    esg:runIndex "43" ;
    esg:recordIndex "3" .

esgr:Record_r043_004 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_detection ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "Pada tanggal 27 September 2024, Perusahaan menandatangani Surat Perjanjian Kerahasiaan (NDA) dengan PT Agro Multi Persada. NDA tersebut berisi bahwa kedua perusahaan sepakat sehubungan adanya kemungkinan kerja sama dalam penggunaan truk dan bus listrik milik perusahaan oleh AMP untuk tujuan uji coba kendaraan listrik Perusahaan." ;
    esg:reasoning "Teks menunjukkan komitmen untuk menguji coba kendaraan listrik, yang merupakan langkah menuju adopsi teknologi rendah emisi. Namun, ini masih bersifat potensial dan belum menjadi tindakan konkret." ;
    esg:timestamp "2026-04-08T02:53:20.718700Z" ;
    esg:sourceTarget "vktr_ar_sr_2024_pdf/batch_20" ;
    esg:runIndex "43" ;
    esg:recordIndex "4" .

esgr:Record_r043_005 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
    esg:hasAspect esgr:Aspect_climate_detection ;
    esg:hasPillar esgr:ESGPillar_e ;
    esg:hasTone esgr:Tone_commitment ;
    esg:hasSentiment esgr:Sentiment_neutral ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_d ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_specificity ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_commitment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_sentiment ;
    esg:hasClimateLabel esgr:ClimateLabel_climate_s ;
    esg:recordText "Pada tanggal 1 Juni 2024, Perusahaan menandatangani Memorandum of Understanding dengan WBKM. Perusahaan, sebagai perusahaan yang bergerak di bidang perdagangan dan manufaktur kendaraan listrik, dan WBKM, sebagai Perusahaan yang menyediakan angkutan umum, ingin mengeksplorasi dan mempertimbangkan peluang untuk melakukan kerjasama timbal balik yang lebih luas pada proyek di Indonesia." ;
    esg:reasoning "Teks menggambarkan eksplorasi kerja sama untuk proyek kendaraan listrik, yang menunjukkan komitmen terhadap transportasi berkelanjutan. Namun, ini masih dalam tahap perencanaan dan belum menjadi tindakan nyata." ;
    esg:timestamp "2026-04-08T02:53:20.718700Z" ;
    esg:sourceTarget "vktr_ar_sr_2024_pdf/batch_20" ;
    esg:runIndex "43" ;
    esg:recordIndex "5" .

esgr:Record_r043_006 a esg:ESGRecord ;
    esg:fromCompany esgr:Company_vktr_ar_sr_2024 ;
    esg:generatedByModel esgr:Model_arcee_ai_trinity_large_preview_free ;
    esg:usedPrompt esgr:Prompt_tone_chain_of_thought_indonesian_md ;
