@article{qianxing_chen_a968d27d,
  author = {Qianxing Chen},
  title = {From Text Analysis to Metrics: AI Approaches to ESG Assessment},
  abstract = {In ESG assessments, disclosure-centric scorecards are being replaced by AI-based sentence-level systems, which offer organized aggregate based on precise criteria. The shift from topic models and human supervision to domain-adaptive Transformer classifiers and evidence-based language models with retrieval capabilities is traced in this work. In order to create trustworthy textual metrics from news, earnings calls, and reports, we concentrate on multi-label phrase annotation by combining non-ESG controls, industry materiality, and financial sentiment. The evaluation takes precision/recall, external validity, and structural variations among rating agencies into account. Decision-making applications in supply chain visibility, investment research, and disclosure assurance are covered, as well as governance elements like documentation, energy use, and human-computer interaction. We conclude by outlining potential avenues for future research and development, such as cross-lingual robustness, retrieval stability, benchmark design, and low-carbon AI. Our suggested "text → metrics → econometrics" approach complements current ratings while improving the scalability, timeliness, comparability, and auditability of ESG measurement.},
  journal = {Academic Journal of Science and Technology},
  volume = {19},
  issue = {2},
  pages = {23-28},
  year = {2026},
  month = {01},
  doi = {10.54097/wr1teh04},
  issn = {2771-3032},
  isbn = {},
  url = {https://doi.org/10.54097/wr1teh04}
}
@article{chao_li_15691877,
  author = {Chao Li AND Alexander Ryota Keeley AND Shunsuke Managi},
  title = {ESG emphasis of top companies in East and Southeast Asian countries unveiled by deep learning},
  abstract = {Environmental, social, and governance (ESG) considerations are becoming increasingly vital in evaluating corporate performance and addressing global challenges. This study examines the ESG emphasis of leading companies in eight East and Southeast Asian countries through the analysis of 480 corporate reports published in 2024. By employing the Text Match Pre-trained Transformer (TMPT) model, which features advanced zero-shot learning capabilities with 519,939,541 parameters for multi-language analyses, we investigate the relatedness of report contents to 13 ESG-related topics across environmental, social, and economic dimensions. This zero-shot framework enables accurate and language-independent ESG analysis without the need for task-specific fine-tuning, allowing consistent comparison across countries. Our findings reveal that economic topics, including governance risk, production cost, and economic ripple effect, dominate corporate emphasis, while significant regional variations exist. Specifically, South Korean companies prioritize environmental and social issues, whereas Chinese firms focus more heavily on economic aspects. Japanese corporations demonstrate a balanced pattern, emphasizing work environment and domestic job creation, while companies in Indonesia, Malaysia, and the Philippines emphasize community-related topics and human rights. This research highlights the capabilities of AI-driven models in investigating specific patterns in corporate ESG emphasis across multilingual datasets. By providing a detailed understanding of regional ESG priorities and tendencies, this study demonstrates emphasis variations among countries, sectors, and topics to support societal efforts towards accountability and sustainable development. • Deep learning maps ESG focus in 480 top Asian corporate reports. • Economic topics dominate; social and environmental vary by country. • Sector influence outweighs country in shaping ESG disclosure patterns. • Multilingual report consistency strong in China, Japan, Korea; weaker elsewhere. • TMPT model enables accurate, scalable ESG analysis across languages.},
  journal = {Green Technologies and Sustainability},
  volume = {4},
  issue = {2},
  pages = {100296-100296},
  year = {2025},
  month = {10},
  doi = {10.1016/j.grets.2025.100296},
  issn = {2949-7361},
  isbn = {},
  url = {https://doi.org/10.1016/j.grets.2025.100296},
  publisher = {Elsevier BV}
}
