# Rename this file to `.env` and update the values to match your Hugging Face Space URLs.

# For ABSA (Aspect-Based Sentiment Analysis) Space
HF_ABSA_SPACE=your-org-or-username/your-absa-space

# For ESG data model (training/evaluation etc.)
HF_ESGDATA_SPACE=your-org-or-username/your-esgdata-space

# For general ESG scoring Space (used by api_client.py)
HF_SPACE=your-org-or-username/your-esg-space
